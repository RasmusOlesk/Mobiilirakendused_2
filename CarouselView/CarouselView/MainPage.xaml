<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://microsoft.com"
             xmlns:x="http://microsoft.com"
             xmlns:models="clr-namespace:CarouselView.Models"
             xmlns:strings="clr-namespace:CarouselView.Resources.Localization"
             x:Class="CarouselView.MainPage">

    <ContentPage.BindingContext>
        <!-- ViewModel asub Models kaustas, seega kasutame eesliidet 'models:' -->
        <models:MainPageViewModel />
    </ContentPage.BindingContext>

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B1055" Offset="0.1" />
            <GradientStop Color="#7597DE" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Padding="20">

        <Label Grid.Row="0" 
               Text="Programmeerimiskeeled / Portfolio"
               HorizontalOptions="Center" 
               FontSize="26" 
               FontAttributes="Bold" 
               TextColor="White" 
               Margin="0,10,0,20"/>

        <CarouselView Grid.Row="1" 
                      ItemsSource="{Binding Languages}" 
                      Position="{Binding Position, Mode=TwoWay}"
                      IndicatorView="indicatorView"
                      PeekAreaInsets="20">
            <CarouselView.ItemTemplate>
                <!-- Mudel asub samuti Models kaustas -->
                <DataTemplate x:DataType="models:LanguageModel">
                    <ContentView Padding="10">
                        <Frame CornerRadius="20" 
                               HasShadow="True" 
                               BackgroundColor="White" 
                               BorderColor="Transparent"
                               Padding="20">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type models:MainPageViewModel}}, Path=ItemSelectedCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>

                            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                                <Image Source="{Binding ImageUrl}" 
                                       HeightRequest="130" 
                                       WidthRequest="130" 
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Name}" 
                                       FontSize="24" 
                                       FontAttributes="Bold" 
                                       HorizontalOptions="Center" 
                                       TextColor="#2B1055"/>
                                <Label Text="{Binding Description}" 
                                       FontSize="14" 
                                       HorizontalOptions="Center" 
                                       HorizontalTextAlignment="Center"
                                       TextColor="Gray"/>
                            </StackLayout>
                        </Frame>
                    </ContentView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView Grid.Row="2" 
                       x:Name="indicatorView"
                       IndicatorColor="LightGray"
                       SelectedIndicatorColor="White"
                       HorizontalOptions="Center" 
                       Margin="0,15,0,15" />

        <Button Grid.Row="3" 
                Text="{Binding CurrentLanguage, StringFormat='Keel / Language: {0}'}"
                Command="{Binding ChangeLanguageCommand}"
                BackgroundColor="#FF79C6" 
                TextColor="White" 
                FontAttributes="Bold"
                CornerRadius="25"
                HeightRequest="50"
                HorizontalOptions="Center"
                WidthRequest="220"/>
    </Grid>
</ContentPage>
