<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:CarouselView.Models"
    x:Class="CarouselView.MainPage">

    <ContentPage.BindingContext>
        <models:MainPageViewModel />
    </ContentPage.BindingContext>

    <!-- Taust -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2B1055" Offset="0.1" />
            <GradientStop Color="#7597DE" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Padding="20">

        <!-- Pealkiri -->
        <Label
            Grid.Row="0"
            Text="Programmeerimiskeeled / Portfolio"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="White"
            Margin="0,10,0,20" />

        <!-- Kaartide karussell -->
        <CarouselView
            x:Name="languagesCarousel"
            Grid.Row="1"
            ItemsSource="{Binding Languages}"
            Position="{Binding Position, Mode=TwoWay}"
            IndicatorView="indicatorView"
            PeekAreaInsets="20">

            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="models:LanguageModel">

                    <ContentView Padding="10">

                        <Border
                            BackgroundColor="White"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            Padding="20">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>

                            <!-- Kaardile vajutamine avab info -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type models:MainPageViewModel}}, Path=ItemSelectedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Spacing="15">

                                <!-- Programmeerimiskeele pilt -->
                                <Border
                                    WidthRequest="180"
                                    HeightRequest="180"
                                    BackgroundColor="#F5F2FA"
                                    Stroke="Transparent"
                                    Padding="10"
                                    HorizontalOptions="Center">

                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>

                                    <Image
                                        Source="{Binding ImageUrl}"
                                        Aspect="AspectFit"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill" />
                                </Border>

                                <!-- Keele nimi -->
                                <Label
                                    Text="{Binding Name}"
                                    FontSize="26"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#2B1055" />

                                <!-- Keele kirjeldus -->
                                <Label
                                    Text="{Binding Description}"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    TextColor="Gray" />

                                <!-- Keele järgi muutuv juhis -->
                                <Label
                                    Text="{Binding TapHint,
                                        Source={RelativeSource AncestorType={x:Type models:MainPageViewModel}}}"
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#8A78A8" />

                            </VerticalStackLayout>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Kaartide indikaatorid -->
        <IndicatorView
            x:Name="indicatorView"
            Grid.Row="2"
            IndicatorColor="LightGray"
            SelectedIndicatorColor="#FF79C6"
            HorizontalOptions="Center"
            Margin="0,15,0,15" />

        <!-- Keelevahetuse nupp -->
        <Button
            Grid.Row="3"
            Text="{Binding CurrentLanguage,
                StringFormat='Keel / Language: {0}'}"
            Command="{Binding ChangeLanguageCommand}"
            BackgroundColor="#FF79C6"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="25"
            HeightRequest="50"
            HorizontalOptions="Center"
            WidthRequest="220" />

    </Grid>
</ContentPage>