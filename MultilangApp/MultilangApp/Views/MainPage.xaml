<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MultilangApp.ViewModels"
             x:Class="MultilangApp.Views.MainPage"
             BackgroundColor="#F5F7FA">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="24"
            VerticalOptions="Center">

            <!-- Header -->
            <VerticalStackLayout
                Spacing="8"
                HorizontalOptions="Center">

                <Label
                    Text="{Binding Greeting}"
                    FontSize="36"
                    FontAttributes="Bold"
                    TextColor="#1F2937"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="{Binding ChangeLanguageLabel}"
                    FontSize="18"
                    TextColor="#6B7280"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>


            <!-- Language Card -->
            <Border
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeThickness="1"
                Padding="20"
                HorizontalOptions="Fill">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Choose your language"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="#374151" />


                    <!-- ENGLISH -->
                    <Border
                        BackgroundColor="#F3F4F6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        HeightRequest="64">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SetEnglishCommand}" />
                        </Border.GestureRecognizers>

                        <Grid
                            Padding="10"
                            ColumnDefinitions="60,*">

                            <!-- Fixed flag box -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="36"
                                BackgroundColor="White"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Image
                                    Source="flag_en.png"
                                    WidthRequest="70"
                                    HeightRequest="59"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding EnglishButton}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#1F2937"
                                VerticalOptions="Center"
                                Margin="10,0,0,0" />

                        </Grid>
                    </Border>


                    <!-- RUSSIAN -->
                    <Border
                        BackgroundColor="#F3F4F6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        HeightRequest="64">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SetRussianCommand}" />
                        </Border.GestureRecognizers>

                        <Grid
                            Padding="10"
                            ColumnDefinitions="60,*">

                            <!-- Fixed flag box -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="36"
                                BackgroundColor="White"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Image
                                    Source="flag_ru.jpg"
                                    WidthRequest="50"
                                    HeightRequest="39"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding RussianButton}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#1F2937"
                                VerticalOptions="Center"
                                Margin="10,0,0,0" />

                        </Grid>
                    </Border>


                    <!-- ESTONIAN -->
                    <Border
                        BackgroundColor="#F3F4F6"
                        Stroke="#D1D5DB"
                        StrokeThickness="1"
                        HeightRequest="64">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding SetEstonianCommand}" />
                        </Border.GestureRecognizers>

                        <Grid
                            Padding="10"
                            ColumnDefinitions="60,*">

                            <!-- Fixed flag box -->
                            <Border
                                Grid.Column="0"
                                WidthRequest="48"
                                HeightRequest="36"
                                BackgroundColor="White"
                                Stroke="#D1D5DB"
                                StrokeThickness="1"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="6" />
                                </Border.StrokeShape>

                                <Image
                                    Source="flag_et.png"
                                    WidthRequest="44"
                                    HeightRequest="32"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" />

                            </Border>

                            <Label
                                Grid.Column="1"
                                Text="{Binding EstonianButton}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="#1F2937"
                                VerticalOptions="Center"
                                Margin="10,0,0,0" />

                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
